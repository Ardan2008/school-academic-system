APP_NAME=SASKANSA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=SASKANSA

# Notifikasi permintaan bantuan dari pop-up "Hubungi Tim IT Sekolah" di landing page.
# Kosongkan kalau notifikasi email tidak dipakai; permintaan tetap tersimpan di database.
IT_SUPPORT_EMAIL=
IT_SUPPORT_NAME="Tim IT Sekolah"

# Backup Database (menu Admin > Backup Database)
# Disk "local" memakai storage/app/private, jadi file .sql tidak bisa diakses lewat URL publik.
# Jangan diisi "public" karena isinya seluruh isi database sekolah.
BACKUP_DISK=local
BACKUP_FOLDER=backups
# Jumlah backup yang dipertahankan sebelum yang lama dihapus otomatis. 0 = tidak ada batas.
BACKUP_KEEP=10
# Jumlah baris per perintah INSERT. Makin besar makin cepat, tapi perintah jadi lebih panjang.
BACKUP_ROWS_PER_INSERT=200
# Lama kunci backup ditahan (detik). Harus lebih besar dari perkiraan durasi backup terlama.
BACKUP_TIMEOUT=600
# Berapa detik menunggu backup lain yang sedang berjalan sebelum ditolak. 0 = langsung ditolak.
BACKUP_LOCK_WAIT=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# JWT Auth (generate dengan: php artisan jwt:secret)
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

VITE_APP_NAME="${APP_NAME}"
